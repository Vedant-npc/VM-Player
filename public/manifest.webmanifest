{
  "name": "VM Player - Video & Media Player",
  "short_name": "VM Player",
  "description": "Studio-grade media player with 5s precision seeking, volume HUD, hold-for-2x speed boost, and local video file handling.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#090C10",
  "background_color": "#090C10",
  "categories": ["multimedia", "video", "entertainment", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Video Player",
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/webm": [".webm"],
        "video/x-matroska": [".mkv"],
        "video/quicktime": [".mov"],
        "video/x-msvideo": [".avi"],
        "video/ogg": [".ogv"]
      }
    }
  ]
}
